def check_even_odd(n):
    if n % 2 == 0:
        print("Even Number")
    else:
        print("Odd Number")

def check_prime(n):
    if n <= 1:
        print("Not a Prime Number")
        return

    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            print("Not a Prime Number")
            return

    print("Prime Number")

num = int(input("Enter a number: "))

check_even_odd(num)
check_prime(num)
